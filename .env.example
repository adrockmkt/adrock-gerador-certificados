# Defina um valor aleatório longo fora do repositório.
SECRET_KEY=
# Exemplo local: sqlite:////caminho/privado/certificates.sqlite3
DATABASE_URL=
# Diretório privado, fora da raiz pública do servidor.
PRIVATE_STORAGE_DIR=
# Caminho público da aplicação quando servida atrás do NGINX.
APPLICATION_ROOT=/gerador-certificados
# Domínios permitidos, separados por vírgulas. Ex.: certificados.exemplo.com
TRUSTED_HOSTS=
# Defina 1 atrás de HTTPS em produção.
SESSION_COOKIE_SECURE=0

